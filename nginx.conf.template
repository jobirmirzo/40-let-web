server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # Hashed build assets (Vite outputs content-hashed filenames) can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Backend API, reverse-proxied so the SPA can call same-origin paths.
    # BACKEND_UPSTREAM is set via the container environment (see docker-compose.yml).
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — client-side routing decides what to render.
    location / {
        try_files $uri /index.html;
    }
}
